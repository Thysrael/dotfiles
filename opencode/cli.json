{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "kanagawa"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "session.timeline": "<leader>g",
    "session.interrupt": "escape",
    "session.background": "<leader>ctrl+b",
    "session.compact": "<leader>c",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "session.toggle.thinking": "ctrl+o"
  },
  "scroll": {
    "speed": 4,
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
